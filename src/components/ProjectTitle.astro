---
interface Props {
  title: string
  link?: string
  arxiv?: string
  page?: string
  as?: 'h1' | 'h2' | 'h3'
}

const { title, link, arxiv, page, as: Heading = 'h3' } = Astro.props

const GITHUB_PATH =
  'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8Z'

const BOOK_PATH =
  'M0 1.75A.75.75 0 0 1 .75 1h4.253c1.227 0 2.317.59 3 1.501A3.743 3.743 0 0 1 11.006 1h4.245a.75.75 0 0 1 .75.75v10.5a.75.75 0 0 1-.75.75h-4.507a2.25 2.25 0 0 0-1.591.659l-.622.621a.75.75 0 0 1-1.06 0l-.622-.621A2.25 2.25 0 0 0 5.258 13H.75a.75.75 0 0 1-.75-.75Zm7.251 10.324.004-5.073-.002-2.253A2.25 2.25 0 0 0 5.003 2.5H1.5v9h3.757a3.75 3.75 0 0 1 1.994.574ZM8.755 4.75l-.004 7.322a3.752 3.752 0 0 1 1.992-.572H14.5v-9h-3.495a2.25 2.25 0 0 0-2.25 2.25Z'

const ARXIV_PATH =
  'M3.8423 0a1.0037 1.0037 0 0 0-.922.6078c-.1536.3687-.0438.6275.2938 1.1113l6.9185 8.3597-1.0223 1.1058a1.0393 1.0393 0 0 0 .003 1.4229l1.2292 1.3135-5.4391 6.4444c-.2803.299-.4538.823-.2971 1.1986a1.0253 1.0253 0 0 0 .9585.635.9133.9133 0 0 0 .6891-.3405l5.783-6.126 7.4902 8.0051a.8527.8527 0 0 0 .6835.2597.9575.9575 0 0 0 .8777-.6138c.1577-.377-.017-.7502-.306-1.1407l-7.0518-8.3418 1.0632-1.13a.9626.9626 0 0 0 .0089-1.3165L4.6336.4639s-.3733-.4535-.768-.463zm0 .272h.0166c.2179.0052.4874.2715.5644.3639l.005.006.0052.0055 10.169 10.9905a.6915.6915 0 0 1-.0072.945l-1.0666 1.133-1.4982-1.7724-8.5994-10.39c-.3286-.472-.352-.6183-.2592-.841a.7307.7307 0 0 1 .6704-.4401Zm14.341 1.5701a.877.877 0 0 0-.6554.2418l-5.6962 6.1584 1.6944 1.8319 5.3089-6.5138c.3251-.4335.479-.6603.3247-1.0292a1.1205 1.1205 0 0 0-.9763-.689zm-7.6557 12.2823 1.3186 1.4135-5.7864 6.1295a.6494.6494 0 0 1-.4959.26.7516.7516 0 0 1-.706-.4669c-.1119-.2682.0359-.6864.2442-.9083l.0051-.0055.0047-.0055z'

const href = page ?? link
const label = page ? 'read the writeup' : 'on GitHub'
const size =
  Heading === 'h1' ? 'text-hero-mobile md:text-hero' : 'text-project'
---

<Heading class:list={[size, 'font-serif font-semibold']}>
  {
    href ? (
      <a
        href={href}
        target={page ? undefined : '_blank'}
        rel={page ? undefined : 'noopener noreferrer'}
        class="group text-inherit no-underline hover:underline"
      >
        {title}
        <svg
          viewBox="0 0 16 16"
          aria-hidden="true"
          class="ml-2 inline-block size-[0.6em] fill-current align-baseline opacity-40 transition-opacity group-hover:opacity-70"
        >
          <path d={page ? BOOK_PATH : GITHUB_PATH} />
        </svg>
        <span class="sr-only">{label}</span>
      </a>
    ) : (
      <span class="group text-inherit">{title}</span>
    )
  }
  {
    page && link && (
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="group ml-2 inline-block text-inherit no-underline hover:underline"
      >
        <svg
          viewBox="0 0 16 16"
          aria-hidden="true"
          class="inline-block size-[0.6em] fill-current align-baseline opacity-40 transition-opacity group-hover:opacity-70"
        >
          <path d={GITHUB_PATH} />
        </svg>
        <span class="sr-only">on GitHub</span>
      </a>
    )
  }
  {
    arxiv && (
      <a
        href={arxiv}
        target="_blank"
        rel="noopener noreferrer"
        class="group ml-2 inline-block text-inherit no-underline hover:underline"
      >
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          class="inline-block size-[0.6em] fill-current align-baseline opacity-40 transition-opacity group-hover:opacity-70"
        >
          <path d={ARXIV_PATH} />
        </svg>
        <span class="sr-only">on arXiv</span>
      </a>
    )
  }
</Heading>

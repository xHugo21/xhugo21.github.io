---
import "@/styles/globals.css";
import Layout from "../layouts/Layout.astro";
import ProjectTitle from "../components/ProjectTitle.astro";
import { getCollection } from "astro:content";

let projects = await getCollection("projects");
projects = projects.sort((a, b) => a.data.order - b.data.order);

const writeupIds = new Set(
  (await getCollection("writeups")).map((writeup) => writeup.id),
);
---

<Layout title="Projects - Hugo García">
  <main
    class="px-8 pt-12 pb-32 md:py-32 md:min-h-screen md:flex md:items-center md:justify-center"
  >
    <div class="w-full max-w-3xl mx-auto">
      <div class="space-y-8">
        <header class="space-y-4">
          <a href="/" class="link text-small inline-block">← Home</a>
          <h1 class="text-hero-mobile md:text-hero font-serif font-bold">
            Projects
          </h1>
        </header>

        <div class="space-y-6">
          {
            projects.map((project) => (
              <article class="space-y-1">
                <ProjectTitle
                  title={project.data.title}
                  link={project.data.link}
                  page={
                    writeupIds.has(project.id)
                      ? `/projects/${project.id}`
                      : undefined
                  }
                />                <p class="text-body text-text-secondary dark:text-text-secondary-dark leading-relaxed">
                  {project.data.description}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </main>
</Layout>
